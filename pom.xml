<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Aggregator only: builds every project in one reactor. It is NOT a parent;
         each project under modules/ stays an independent root project. -->
    <groupId>tungnn.tutor.java</groupId>
    <artifactId>java-workspace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>java-workspace</name>

    <modules>
        <module>modules/java-core</module>
        <module>modules/java-infra</module>
        <module>modules/java-benchmark</module>
        <module>modules/java-tool</module>
        <module>modules/spring-core</module>
        <module>modules/tool-crawler</module>
        <module>modules/tool-document-translation</module>
        <module>modules/tool-dev-desk</module>
    </modules>
</project>
