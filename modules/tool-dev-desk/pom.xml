<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tungnn.tutor.java.tool</groupId>
    <artifactId>tool-dev-desk</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>tool-dev-desk-api</module>
        <module>tool-dev-desk-core</module>
        <module>tool-dev-desk-plugins/plugin-base64</module>
        <module>tool-dev-desk-plugins/plugin-document-converter</module>
        <module>tool-dev-desk-plugins/plugin-docs-trans</module>
        <module>tool-dev-desk-plugins/plugin-med-md-refine</module>
        <module>tool-dev-desk-app</module>
    </modules>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hub.plugins.output.dir>${project.basedir}/../../dist/plugins</hub.plugins.output.dir>
        <pf4j.version>3.14.1</pf4j.version>
        <slf4j.version>2.0.16</slf4j.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <java.workspace.infra.version>1.0.0-SNAPSHOT</java.workspace.infra.version>
        <fmt-maven-plugin.version>2.27.0.2</fmt-maven-plugin.version>
        <open-java-format.version>21.0.2</open-java-format.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tungnn.tutor.java.tool</groupId>
                <artifactId>tool-dev-desk-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pf4j</groupId>
                <artifactId>pf4j</artifactId>
                <version>${pf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                    <configuration>
                        <outputDirectory>${hub.plugins.output.dir}</outputDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>dev.openjavaformat</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>dev.openjavaformat</groupId>
                        <artifactId>open-java-format</artifactId>
                        <version>${open-java-format.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>