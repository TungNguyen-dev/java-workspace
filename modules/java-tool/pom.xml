<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tungnn.tutor.java</groupId>
        <artifactId>java-workspace</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>tungnn.tutor.java.tool</groupId>
    <artifactId>java-tool</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>java-tool</name>
    <description>Core libraries shared by the tool applications</description>

    <properties>
        <java-infra.version>1.0.0-SNAPSHOT</java-infra.version>
        <java-lib.version>1.0.0-SNAPSHOT</java-lib.version>
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <jackson-3-bom.version>3.1.5</jackson-3-bom.version>
        <guava.version>33.4.0-jre</guava.version>
    </properties>

    <!-- Align Jackson 2.x and 3.x artifacts pulled in by java-infra (previously managed by Spring Boot) -->
    <dependencyManagement>
        <dependencies>
            <!-- language-detector (via tika-langdetect-optimaize) pulls Guava 18, which google-genai cannot run on -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-ai</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-claude-code</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-csv</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-document</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-jackson</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-mail</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java.infra</groupId>
                <artifactId>java-selenium</artifactId>
                <version>${java-infra.version}</version>
            </dependency>
            <dependency>
                <groupId>tungnn.tutor.java</groupId>
                <artifactId>java-lib</artifactId>
                <version>${java-lib.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-2-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-3-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>tool-crawler-core</module>
        <module>tool-document-translation-core</module>
        <module>tool-med-doc-trans-core</module>
        <module>tool-personal-finance-core</module>
        <module>tool-selenium-browser-setup</module>
        <module>tool-todo-task-core</module>
    </modules>

</project>
