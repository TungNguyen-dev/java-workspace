<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tungnn.tutor.java.tool</groupId>
        <artifactId>java-tool</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tool-personal-finance-core</artifactId>

    <properties>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    </properties>

    <name>tool-personal-finance-core</name>
    <description>Reads personal finance data from several sources, normalizes it and writes it to a dedicated finance application</description>
    <dependencies>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-document</artifactId>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infra</groupId>
            <artifactId>java-selenium</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>tungnn.tutor.java.tool.finance.FinanceSyncApp</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
