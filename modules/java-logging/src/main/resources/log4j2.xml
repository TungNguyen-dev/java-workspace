<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="tungnn.tutor.java" level="${sys:log.level:-${env:LOG_LEVEL:-INFO}}"/>

        <Logger name="software.amazon.awssdk" level="INFO"/>
        <Logger name="org.apache.pdfbox" level="WARN"/>
        <Logger name="org.apache.fontbox" level="WARN"/>
        <Logger name="org.apache.poi" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
