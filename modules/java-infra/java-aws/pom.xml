<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tungnn.tutor.java.infra</groupId>
        <artifactId>java-infra</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>java-aws</artifactId>

    <name>java-aws</name>
    <description>AWS SDK v2 service wrappers and integration module</description>

    <properties>
        <aws.sdk.version>2.46.14</aws.sdk.version>
    </properties>

    <!-- ===================================================================== -->
    <!-- Dependency Management                                                 -->
    <!-- ===================================================================== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ===================================================================== -->
    <!-- Dependencies                                                          -->
    <!-- ===================================================================== -->
