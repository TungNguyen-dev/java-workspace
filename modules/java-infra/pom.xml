<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tungnn.tutor.java</groupId>
        <artifactId>java-workspace</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>tungnn.tutor.java.infra</groupId>
    <artifactId>java-infra</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java-lib.version>1.0.0-SNAPSHOT</java-lib.version>
    </properties>
    <modules>
        <module>java-ast</module>
        <module>java-aws</module>
        <module>java-kafka</module>
        <module>java-jackson</module>
        <module>java-jasper</module>
        <module>java-jol</module>
        <module>java-document</module>
        <module>java-selenium</module>
        <module>java-mail</module>
        <module>java-csv</module>
        <module>java-ini</module>
        <module>java-ocr</module>
        <module>java-liquibase</module>
        <module>java-cron-expression</module>
        <module>java-zip</module>
        <module>java-ai</module>
        <module>java-obsidian</module>
        <module>java-docker</module>
        <module>java-claude-code</module>

    </modules>

    <!-- Repositories for dependencies -->
    <repositories>
        <!-- Oracle Maven Repository -->
        <repository>
            <id>oracle-repo</id>
            <url>https://repo.oracle.com/maven</url>
        </repository>
    </repositories>

    <!-- Directly Inherited Dependencies -->
    <dependencies>

        <!-- ===== Database Drivers ===== -->

        <!-- Oracle JDBC Driver -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.3.0.23.09</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <dependency>
            <groupId>tungnn.tutor.java</groupId>
            <artifactId>java-lib</artifactId>
            <version>${java-lib.version}</version>
        </dependency>
    </dependencies>

</project>
