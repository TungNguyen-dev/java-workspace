<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tungnn.tutor.java.tool</groupId>
    <artifactId>tool-hub</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>tool-hub-api</module>
        <module>tool-hub-core</module>
        <module>tool-hub-plugins/plugin-base64</module>
        <module>tool-hub-plugins/plugin-samples</module>
        <module>tool-hub-plugins/plugin-document-converter</module>
        <module>tool-hub-plugins/plugin-docs-trans</module>
        <module>tool-hub-plugins/plugin-med-md-refine</module>
        <module>tool-hub-app</module>
    </modules>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <pf4j.version>3.14.1</pf4j.version>
        <slf4j.version>2.0.16</slf4j.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <java.workspace.infra.version>1.0.0-SNAPSHOT</java.workspace.infra.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tungnn.tutor.java.tool</groupId>
                <artifactId>tool-hub-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pf4j</groupId>
                <artifactId>pf4j</artifactId>
                <version>${pf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>