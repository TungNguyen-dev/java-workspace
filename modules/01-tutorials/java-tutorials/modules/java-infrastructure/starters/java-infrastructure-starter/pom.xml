<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tungnn.tutor.java.infrastructure</groupId>
        <artifactId>java-infrastructure</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>java-infrastructure-starter</artifactId>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <!-- Giống java-ai: dependencyManagement của dependency không được thừa kế, nên phải import
        lại BOM. Nếu không, java-jackson kéo jackson-annotations 2.18 và Spring AI (Jackson 3.1.x)
        lỗi NoClassDefFoundError: JsonSerializeAs (cần jackson-annotations >= 2.21). -->
        <jackson.version>3.1.5</jackson.version>
        <jackson2.version>2.21.5</jackson2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-jackson</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-jasper</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-jol</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-mail</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-document</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-ast</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-selenium</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-csv</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-aws</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-ini</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-ocr</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-liquibase</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-cron-expression</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-zip</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>tungnn.tutor.java.infrastructure</groupId>
            <artifactId>java-ai</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>