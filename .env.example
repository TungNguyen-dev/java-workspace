# Copy to dev.env (git-ignored) and fill in real values. Never commit secrets.
# `KEY=value` is active; `KEY=` with no value is for you to fill in; `#KEY=` is off on purpose (see the note above it).

# ==============================================================================
# Database (java-lib, java-jasper, java-liquibase)
# JDBC connection used by the demos, the reports and the migrations.
# ==============================================================================
DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USER=
DB_PASS=

# ==============================================================================
# AWS (java-aws)
# Profile, region and credential files read by the AWS SDK.
# ==============================================================================
AWS_PROFILE=default
AWS_CONFIG_FILE=~/.aws/config
AWS_SHARED_CREDENTIALS_FILE=~/.aws/credentials
AWS_REGION=ap-southeast-1
AWS_SDK_ENABLE_METRICS=true

# ==============================================================================
# Logging
# Log level of the doctrans tools and the Log4j debug switch.
# ==============================================================================
# TRACE < DEBUG < INFO < WARN < ERROR
LOG_LEVEL_DOCTRANS=INFO
LOG4J_DEBUG=false
# Off on purpose: an empty value makes Log4j look for an empty config path. Set a real file to enable it.
#LOG4J_CONFIGURATION_FILE=

# ==============================================================================
# OCR (java-ocr)
# Location of the Tesseract language data (tessdata).
# ==============================================================================
TESSDATA_PATH=

# ==============================================================================
# Selenium (java-selenium)
# ChromeDriver and Chrome paths, and the WebDriver pool (WebDriverPoolConfig.fromEnv, defaults shown).
# ==============================================================================
# Do NOT export DYLD_LIBRARY_PATH system-wide on macOS: it crashes Chrome spawned by ChromeDriver.
WEBDRIVER_CHROME_DRIVER_PATH=
WEBDRIVER_CHROME_BINARY_PATH=
WEBDRIVER_CHROME_PROFILE_ROOT_DIR=
WEBDRIVER_POOL_MAX_TOTAL=4
WEBDRIVER_POOL_MAX_IDLE=4
WEBDRIVER_POOL_MIN_IDLE=0
WEBDRIVER_POOL_MAX_WAIT_SECONDS=600
WEBDRIVER_POOL_TEST_ON_BORROW=true
WEBDRIVER_POOL_PROFILE_PREFIX=profile_
WEBDRIVER_POOL_HEADLESS=false

# ==============================================================================
# Obsidian (java-obsidian)
# Obsidian CLI path and the default vault, folders and author. Needs Obsidian 1.12.7+ with
# Settings > General > Command line interface enabled.
# ==============================================================================
# Point to the CLI symlink, not Obsidian.app/Contents/MacOS/obsidian (the GUI binary).
OBSIDIAN_CLI_PATH=/usr/local/bin/obsidian
# Vault name or id. Leave empty to use the active vault.
OBSIDIAN_VAULT=
OBSIDIAN_TIMEOUT_SECONDS=60
OBSIDIAN_TEMPLATES_FOLDER=Templates
OBSIDIAN_REPORTS_FOLDER=Reports
OBSIDIAN_AUTHOR=

# ==============================================================================
# Tool Dev Desk (tool-dev-desk-app)
# Plugin and data directories, HTTP port and optional Basic auth of the hub.
# ==============================================================================
# Run ToolHubApplication from the IDE and load this file via Run configuration > Environment variables > .env file.
# `mvn package` of each plugin writes its zip to modules/tool-dev-desk/dist/plugins.
# Directory scanned for plugin zips. Prefer an absolute path, e.g. /absolute/path/to/modules/tool-dev-desk/dist/plugins:
# relative paths resolve against the run working directory, and a leading ~/ is expanded. Do not leave it empty.
HUB_PLUGINS_DIR=plugins
# Per-plugin working data (translation memory, uploads, ...). Same path rules as above.
HUB_DATA_DIR=data
# Hot reload plugin zips dropped into or removed from HUB_PLUGINS_DIR.
HUB_WATCH=true
HUB_PORT=8080
# Binds to loopback by default. Set 0.0.0.0 only together with HUB_PASSWORD.
HUB_BIND_ADDRESS=127.0.0.1
# HTTP Basic auth is enabled only when HUB_PASSWORD is set (empty = no auth).
HUB_USERNAME=admin
HUB_PASSWORD=

# ==============================================================================
# Document translation (tool-document-translation-core)
# Default LLM provider and the chunking limits of the generic document translator.
# ==============================================================================
# Provider name: gemini | huggingface | ollama | ollama-openai | deepseek | mistral | ...
DOCTRANS_TRANSLATOR_PROVIDER=deepseek
# Max parallel LLM calls (each call translates one chunk). Empty = the provider default.
DOCTRANS_MAX_CONCURRENCY=
# Max text units merged into one chunk / one LLM call. The default is set by each document type
# (currently 20 for all). Setting it overrides every type. Set 1 to disable batching. Lower it for
# local providers (ollama, lm-studio, vllm), e.g. 5.
DOCTRANS_MAX_BATCH_UNITS=20
# Max total characters per chunk (each unit also counts ~80 chars of overhead). The default is set by
# each document type (currently 3000). Setting it overrides every type.
DOCTRANS_MAX_BATCH_CHARS=3000

# ==============================================================================
# Medical document translation (tool-med-doc-trans-core)
# Which LLM backend each pipeline step uses. The glossary step does not use an LLM.
# ==============================================================================
# Each LLM step (fix-ocr, translate, polish-target, format-target) has its own client. Spec: <backend>[:<model>]
# where backend is claude-cli (the `claude -p` command, no API key) or a provider name (deepseek,
# anthropic, openai, ollama, ...). The model is everything after the first ':', e.g. ollama:qwen3:8b.
# Precedence per step: --llm <step>=<spec>, then DOCTRANS_LLM_<STEP>, then the default below.
# Default for all steps. When unset, DOCTRANS_TRANSLATOR_PROVIDER is used, then deepseek.
DOCTRANS_LLM_DEFAULT=deepseek
DOCTRANS_LLM_FIX_OCR=deepseek
DOCTRANS_LLM_TRANSLATE=claude-cli:sonnet
# Ignored when the translate step uses claude-cli or anthropic: polish-target is always skipped then.
DOCTRANS_LLM_POLISH_TARGET=gemini
DOCTRANS_LLM_FORMAT_TARGET=deepseek
# Parallel claude-cli calls (keep it low for subscription rate limits).
DOCTRANS_CLAUDE_CLI_CONCURRENCY=2

# ==============================================================================
# Claude Code CLI (java-claude-code, cli package)
# Settings of the claude-cli backend. It uses the Claude Code login, so no API key is needed.
# ==============================================================================
# Run `claude` once to log in.
# Path of the executable, needed when `claude` is not on the PATH (e.g. IDE launches on macOS).
CLAUDE_CLI_PATH=claude
# Model when the spec has none: an alias (opus, sonnet, haiku) or a full model id.
CLAUDE_CLI_MODEL=sonnet
# low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT=medium
# Timeout of one call, the process is killed after it.
CLAUDE_CLI_TIMEOUT_SECONDS=600

# ==============================================================================
# LLM providers (java-ai)
# API key, model and base URL of each provider. Fill in only the providers you use; empty values count as unset.
# ==============================================================================

# --- Live tests ---
# Set to true to enable java-ai's LlmClientLiveIT, which makes real (billed) API calls.
LLM_LIVE_TEST=false

# --- Google Gemini --- API key. Vertex AI is the alternative: use it instead of the key, never both.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=
# Off on purpose: with no API key, set GOOGLE_CLOUD_PROJECT to use Vertex AI instead of GEMINI_API_KEY.
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=

# --- Hugging Face --- Inference router (OpenAI-compatible).
HF_TOKEN=
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1

# --- Ollama --- Local models through the OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TOKEN=
OLLAMA_MODEL=llama3
# Off on purpose: the native API is an alternative to OLLAMA_BASE_URL, use one of the two.
#OLLAMA_NATIVE_BASE_URL=http://localhost:11434

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic --- Used by java-ai and java-claude-code.
# java-claude-code reads ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL through AnthropicOkHttpClient.fromEnv();
# ANTHROPIC_MODEL is used by java-ai only (java-claude-code takes the model from ChatOptions).
# Setting ANTHROPIC_API_KEY also enables java-claude-code's ClaudeLiveIT, which makes real (billed) API calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Mistral AI ---
MISTRAL_AI_API_KEY=
MISTRAL_AI_MODEL=mistral-small-latest
MISTRAL_AI_BASE_URL=https://api.mistral.ai

# --- AWS Bedrock --- Credentials come from the AWS section above.
BEDROCK_MODEL=

# --- Other OpenAI-compatible endpoints ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
XAI_API_KEY=
XAI_MODEL=
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=
VLLM_API_KEY=
VLLM_MODEL=
# Any custom OpenAI-compatible server (LLM_BASE_URL is required for this provider)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# =============================================================================
# Personal finance (tool-personal-finance-core)
# Mailbox, LLM provider and folders read by the finance sync. Use an app password for IMAP, never the account password.
# =============================================================================
FINANCE_IMAP_HOST=
FINANCE_IMAP_USER=
FINANCE_IMAP_PASSWORD=
# Root of the macOS Mail store for appleMailSources (e.g. ~/Library/Mail/V10); leave empty to use the newest V<n>.
FINANCE_APPLE_MAIL_ROOT=
# Any provider name of LlmProvider (e.g. ANTHROPIC); leave empty to disable PDF/email extraction and LLM categorizing.
FINANCE_LLM_PROVIDER=
# Base folder that file source directories are resolved against, and where state, ledger and output are stored.
FINANCE_INBOX_DIR=
FINANCE_STORAGE_DIR=

# =============================================================================
# Todo task (tool-todo-task-core)
# Tasks are inline checkboxes in the markdown notes of an Obsidian vault.
# =============================================================================
# Root folder of the Obsidian vault that holds the notes (required unless --vault is passed).
TODO_VAULT_DIR=
# Note (relative to the vault) that new tasks are added to; defaults to Inbox.md.
# {pattern} is replaced with today's date (java.time pattern), e.g. Daily/{yyyy-MM-dd}.md gives one note per day.
TODO_INBOX_NOTE=Daily/{yyyy-MM-dd}.md
# Heading inside the inbox note that new tasks go under; leave empty to append at the end.
TODO_INBOX_HEADING=
# Comma separated vault-relative folders or notes to skip while scanning.
TODO_EXCLUDES=
# Only lines containing this text (e.g. #task) count as tasks; leave empty to treat every checkbox as a task.
TODO_GLOBAL_FILTER=
