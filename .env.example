# Copy to dev.env (git-ignored) and fill in real values. Never commit secrets.

# ---- Database (java-lib jdbc demos, java-jasper, java-liquibase) ----
DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USER=
DB_PASS=

# ---- AWS (java-aws) ----
AWS_PROFILE=default
AWS_CONFIG_FILE=~/.aws/config
AWS_SHARED_CREDENTIALS_FILE=~/.aws/credentials
AWS_REGION=ap-southeast-1
AWS_SDK_ENABLE_METRICS=true

# ---- Logging ----
# TRACE < DEBUG < INFO < WARN < ERROR
LOG_LEVEL_DOCTRANS=INFO
#LOG4J_CONFIGURATION_FILE=
#LOG4J_DEBUG=false

# ---- OCR (java-ocr) ----
TESSDATA_PATH=

# ---- Selenium (java-selenium) ----
# Do NOT export DYLD_LIBRARY_PATH system-wide on macOS: it crashes Chrome spawned by ChromeDriver.
WEBDRIVER_CHROME_DRIVER_PATH=
WEBDRIVER_CHROME_BINARY_PATH=
WEBDRIVER_CHROME_PROFILE_ROOT_DIR=
# Driver pool (WebDriverPoolConfig.fromEnv). Defaults shown.
#WEBDRIVER_POOL_MAX_TOTAL=4
#WEBDRIVER_POOL_MAX_IDLE=4
#WEBDRIVER_POOL_MIN_IDLE=0
#WEBDRIVER_POOL_MAX_WAIT_SECONDS=600
#WEBDRIVER_POOL_TEST_ON_BORROW=true
#WEBDRIVER_POOL_PROFILE_PREFIX=profile_
#WEBDRIVER_POOL_HEADLESS=false

# ---- Obsidian (java-obsidian) ----
# Requires Obsidian 1.12.7+ with Settings > General > Command line interface enabled.
# Point to the CLI symlink, not Obsidian.app/Contents/MacOS/obsidian (the GUI binary).
#OBSIDIAN_CLI_PATH=/usr/local/bin/obsidian
# Vault name or id. Leave empty to use the active vault.
#OBSIDIAN_VAULT=
#OBSIDIAN_TIMEOUT_SECONDS=60
#OBSIDIAN_TEMPLATES_FOLDER=Templates
#OBSIDIAN_REPORTS_FOLDER=Reports
#OBSIDIAN_AUTHOR=

# ---- Tool Dev Desk (tool-dev-desk-app) ----
# Run ToolHubApplication from the IDE and load this file via Run configuration > Environment variables > .env file.
# `mvn package` of each plugin writes its zip to modules/tool-dev-desk/dist/plugins.
# Directory scanned for plugin zips. Prefer an absolute path: relative paths resolve against the run working directory;
# a leading ~/ is expanded.
#HUB_PLUGINS_DIR=/absolute/path/to/modules/tool-dev-desk/dist/plugins
# Per-plugin working data (translation memory, uploads, ...). Default: data
#HUB_DATA_DIR=/absolute/path/to/modules/tool-dev-desk/dist/data
# Hot reload plugin zips dropped into or removed from HUB_PLUGINS_DIR. Default: true
#HUB_WATCH=true
#HUB_PORT=8080
# Binds to loopback by default. Set 0.0.0.0 only together with HUB_PASSWORD.
#HUB_BIND_ADDRESS=127.0.0.1
# HTTP Basic auth is enabled only when HUB_PASSWORD is set.
#HUB_USERNAME=admin
#HUB_PASSWORD=

# ---- Document translation tool ----
# Provider name: gemini | huggingface | ollama | ollama-openai | deepseek | mistral | ...
DOCTRANS_TRANSLATOR_PROVIDER=gemini
# Max parallel LLM calls (each call translates one chunk).
#DOCTRANS_MAX_CONCURRENCY=
# Max text units merged into one chunk / one LLM call. The default is set by each document type
# (currently 20 for all). Setting it overrides every type. Set 1 to disable batching. Lower it for
# local providers (ollama, lm-studio, vllm), e.g. 5.
#DOCTRANS_MAX_BATCH_UNITS=20
# Max total characters per chunk (each unit also counts ~80 chars of overhead). The default is set by
# each document type (currently 3000). Setting it overrides every type.
#DOCTRANS_MAX_BATCH_CHARS=3000

# ---- Medical document translation tool (tool-med-doc-trans-core) ----
# Each LLM step (fix-ocr, glossary, translate, polish-target, format-target) has its own client. Spec: <backend>[:<model>]
# where backend is claude-cli (the `claude -p` command, no API key) or a provider name (deepseek,
# anthropic, openai, ollama, ...). The model is everything after the first ':', e.g. ollama:qwen3:8b.
# Precedence per step: --llm <step>=<spec>, then DOCTRANS_LLM_<STEP>, then the default below.
# Default for all steps. When unset, DOCTRANS_TRANSLATOR_PROVIDER is used, then deepseek.
DOCTRANS_LLM_DEFAULT=deepseek
DOCTRANS_LLM_FIX_OCR=deepseek
DOCTRANS_LLM_GLOSSARY=deepseek
DOCTRANS_LLM_TRANSLATE=claude-cli:sonnet
# Ignored when the translate step uses claude-cli or anthropic: polish-target is always skipped then.
DOCTRANS_LLM_POLISH_TARGET=gemini
DOCTRANS_LLM_FORMAT_TARGET=deepseek
# Parallel claude-cli calls (keep it low for subscription rate limits).
DOCTRANS_CLAUDE_CLI_CONCURRENCY=2

# ---- Claude Code CLI (java-claude-code cli package, used by the claude-cli backend) ----
# Uses the Claude Code login, no API key needed. Run `claude` once to log in.
# Path of the executable, needed when `claude` is not on the PATH (e.g. IDE launches on macOS).
CLAUDE_CLI_PATH=claude
# Model when the spec has none: an alias (opus, sonnet, haiku) or a full model id.
CLAUDE_CLI_MODEL=sonnet
# low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT=medium
# Timeout of one call, the process is killed after it.
CLAUDE_CLI_TIMEOUT_SECONDS=600

# ---- LLM providers (java-ai). Set only those you use. ----
# Set to true to enable java-ai's LlmClientLiveIT, which makes real (billed) API calls.
#LLM_LIVE_TEST=false
# Google Gemini (API key). With no key, set GOOGLE_CLOUD_PROJECT to use Vertex AI instead.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
#GEMINI_BASE_URL=
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=

# Hugging Face
HF_TOKEN=
HF_MODEL=
#HF_BASE_URL=https://router.huggingface.co/v1

# Ollama
#OLLAMA_NATIVE_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TOKEN=
OLLAMA_MODEL=llama3

# DeepSeek
DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=deepseek-chat
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (java-ai and java-claude-code)
# java-claude-code reads ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL through AnthropicOkHttpClient.fromEnv();
# ANTHROPIC_MODEL is used by java-ai only (java-claude-code takes the model from ChatOptions).
# Setting ANTHROPIC_API_KEY also enables java-claude-code's ClaudeLiveIT, which makes real (billed) API calls.
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Mistral AI
#MISTRAL_AI_API_KEY=
#MISTRAL_AI_MODEL=mistral-small-latest
#MISTRAL_AI_BASE_URL=https://api.mistral.ai

# AWS Bedrock (credentials come from the AWS settings above)
#BEDROCK_MODEL=

# Other OpenAI-compatible endpoints
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=
#TOGETHER_API_KEY=
#TOGETHER_MODEL=
#NVIDIA_API_KEY=
#NVIDIA_MODEL=
#PERPLEXITY_API_KEY=
#PERPLEXITY_MODEL=sonar
#XAI_API_KEY=
#XAI_MODEL=
#LM_STUDIO_API_KEY=
#LM_STUDIO_MODEL=
#VLLM_API_KEY=
#VLLM_MODEL=
# Any custom OpenAI-compatible server (LLM_BASE_URL is required for this provider)
#LLM_BASE_URL=
#LLM_API_KEY=
#LLM_MODEL=
